   { name: \"Buddha Mosaic Designer Tile\", image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Buddha-Mosaic-Designer-Wall-Tile-1.webp\", link: \"\/product\/buddha-mosaic-designer-wall-tile\/\" }\n      ]\n    },\n    {\n      id: 7,\n      category: \"kota\",\n      categoryLabel: \"Kota Stone\",\n      title: \"Emerald Stone Courtyard\",\n      preview: \"Kota Green Leather + Salt Brush Finish\",\n      description: \"Curated premium Kota stone textures created specifically for outdoor courtyards, premium villas, and landscape architecture.\",\n      image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Emerald-Stone-Courtyard.webp\",\n      products: [\n        { name: \"Kota Green Leather Stone\", image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/05\/Kota.webp\", link: \"\/product\/kota-green-leather-stone\/\" },\n        { name: \"Kota Green Salt Brush Stone\", image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Kota-Green-Salt-Brush-Finish.webp\", link: \"\/product\/kota-green-salt-brush-finish-stone\/\" }\n      ]\n    },\n    {\n      id: 8,\n      category: \"walltile\",\n      categoryLabel: \"Wall Tiles\",\n      title: \"Urban Artisan Living\",\n      preview: \"Designer Wall Tile + Premium Vitrified Surface\",\n      description: \"A curated luxury interior combination designed for refined artistic living spaces and premium residential design concepts.\",\n      image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Urban-Artisan-Living.webp\",\n      products: [\n        { name: \"Abstract Portrait Designer Tile\", image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Abstract-Portrait-Designer-Wall-Tile-1.webp\", link: \"\/product\/abstract-portrait-designer-wall-tile\/\" },\n        { name: \"Ivory Concrete Vitrified Tile\", image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Ivory-Concrete-Finish-Vitrified-Tiles.webp\", link: \"\/product\/ivory-concrete-finish-vitrified-tile\/\" }\n      ]\n    },\n    {\n      id: 9,\n      category: \"kitchen\",\n      categoryLabel: \"Kitchen Tiles\",\n      title: \"Grandeur Kitchen Atelier\",\n      preview: \"Royal Gold Pattern Kitchen Tile Collection\",\n      description: \"Luxury kitchen inspiration combining premium gold marble patterns with decorative handcrafted wall art finishes.\",\n      image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Grandeur-Kitchen-Atelier.webp\",\n      products: [\n        { name: \"Royal Gold Pattern Kitchen Tile\", image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Royal-Gold-Pattern-Kitchen-Tiles.webp\", link: \"\/product\/royal-gold-pattern-kitchen-tiles\/\" },\n        { name: \"Golden Blossom Stone Mural\", image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Golden-Blossom-Luxury-Stone-Mural-1.webp\", link: \"\/product\/golden-blossom-luxury-stone-mural\/\" }\n      ]\n    },\n    {\n      id: 10,\n      category: \"parking\",\n      categoryLabel: \"Parking Tiles\",\n      title: \"Aangan of Elegance\",\n      preview: \"Graphite Parking Tile + Luxury Stone Mural\",\n      description: \"A bold outdoor design concept created with premium parking tiles and handcrafted luxury decorative wall installations.\",\n      image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Aangan-of-Elegance.webp\",\n      products: [\n        { name: \"Graphite Grid Parking Tile\", image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Graphite-Grid-Parking-Tile-%E2%80%93-Textured-Stone-Finish.webp\", link: \"\/product\/graphite-grid-parking-tile-textured-stone-finish\/\" },\n        { name: \"Tree Of Life Stone Mural\", image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Tree-of-Life-Handcrafted-Stone-Mural.webp\", link: \"\/product\/tree-of-life-handcrafted-stone-mural\/\" }\n      ]\n    },\n    {\n      id: 11,\n      category: \"kitchen\",\n      categoryLabel: \"Kitchen Tiles\",\n      title: \"The Living Palette\",\n      preview: \"Chevron Marble Tile + Kota Green Polish\",\n      description: \"Designed to create sophisticated contemporary kitchen spaces through luxury surface combinations and natural textures.\",\n      image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/The-Living-Palette.webp\",\n      products: [\n        { name: \"Chevron Marble Finish Kitchen Tile\", image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Chevron-Pattern-Kitchen-Tiles.webp\", link: \"\/product\/chevron-marble-finish-kitchen-tiles\/\" },\n        { name: \"Kota Green Polish Stone\", image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Kota-Green-Polish-Stone.webp\", link: \"\/product\/kota-green-polish-stone\/\" }\n      ]\n    },\n    {\n      id: 12,\n      category: \"kota\",\n      categoryLabel: \"Kota Stone\",\n      title: \"Nature Inside Home\",\n      preview: \"Kota Green Waves + Rustic Cube Cladding\",\n      description: \"A premium architectural concept blending natural stone flooring with rustic handcrafted exterior wall textures.\",\n      image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Nature-Inside-Home.webp\",\n      products: [\n        { name: \"Kota Green Waves Stone\", image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Kota-Green-Waves-Stone.webp\", link: \"\/product\/kota-green-waves-stone\/\" },\n        { name: \"Golden Sand Rustic Wall Cladding\", image: \"https:\/\/zamzam.website4u.xyz\/wp-content\/uploads\/2026\/06\/Golden-Sand-Rustic-Cube-Wall-Cladding-Stone.webp\", link: \"\/product\/golden-sand-rustic-cube-wall-cladding-stone\/\" }\n      ]\n    }\n  ];\n\n  const jstFiltersV3 = [\n    { key: \"all\", label: \"All Projects\" },\n    { key: \"kota\", label: \"Kota Stone\" },\n    { key: \"kitchen\", label: \"Kitchen\" },\n    { key: \"bathroom\", label: \"Bathroom\" },\n    { key: \"vitrified\", label: \"Vitrified\" },\n    { key: \"walltile\", label: \"Wall Tiles\" },\n    { key: \"murals\", label: \"Stone Murals\" },\n    { key: \"parking\", label: \"Parking\" }\n  ];\n\n  const root = document.getElementById(\"jst-lux-gallery-v3\");\n  const filterWrap = root.querySelector(\"#jstFiltersV3\");\n  const grid = root.querySelector(\"#jstGridV3\");\n  const popup = root.querySelector(\"#jstPopupV3\");\n  const popupImg = root.querySelector(\"#jstPopupImgV3\");\n  const popupCat = root.querySelector(\"#jstPopupCatV3\");\n  const popupTitle = root.querySelector(\"#jstPopupTitleV3\");\n  const popupDesc = root.querySelector(\"#jstPopupDescriptionV3\");\n  const popupProducts = root.querySelector(\"#jstPopupProductsV3\");\n  const whatsappBtn = root.querySelector(\"#jstWhatsappBtnV3\");\n  const closeBtn = root.querySelector(\"#jstClosePopup\");\n\n  function buildFilters() {\n    filterWrap.innerHTML = jstFiltersV3.map((f, i) =>\n      `<button class=\"jst-pill${i === 0 ? ' active' : ''}\" data-filter=\"${f.key}\">${f.label}<\/button>`\n    ).join('');\n\n    filterWrap.querySelectorAll(\".jst-pill\").forEach(btn => {\n      btn.addEventListener(\"click\", () => {\n        filterWrap.querySelectorAll(\".jst-pill\").forEach(b => b.classList.remove(\"active\"));\n        btn.classList.add(\"active\");\n        renderCards(btn.dataset.filter);\n      });\n    });\n  }\n\n  function renderCards(cat = \"all\") {\n    const list = cat === \"all\" ? jstProjectsV3 : jstProjectsV3.filter(p => p.category === cat);\n\n    grid.innerHTML = list.map(p => `\n      <div class=\"jst-card\" data-id=\"${p.id}\" role=\"button\" tabindex=\"0\" aria-label=\"View ${p.title}\">\n        <div class=\"jst-card-media\">\n          <img src=\"${p.image}\" loading=\"lazy\" decoding=\"async\" alt=\"${p.title}\">\n          <div class=\"jst-card-overlay\"><\/div>\n        <\/div>\n        <div class=\"jst-card-content\">\n          <div class=\"jst-card-cat\">${p.categoryLabel}<\/div>\n          <h3 class=\"jst-card-title\">${p.title}<\/h3>\n          <p class=\"jst-card-preview\">${p.preview}<\/p>\n          <a href=\"#\" class=\"jst-view-btn\" data-project=\"${p.id}\">View Project &#x2192;<\/a>\n        <\/div>\n      <\/div>\n    `).join('');\n\n    grid.querySelectorAll(\".jst-card\").forEach((card, i) => {\n      setTimeout(() => card.classList.add(\"jst-visible\"), i * 60);\n    });\n\n    grid.querySelectorAll(\".jst-view-btn\").forEach(btn => {\n      btn.addEventListener(\"click\", e => {\n        e.preventDefault();\n        e.stopPropagation();\n        openPopup(parseInt(btn.dataset.project, 10));\n      });\n    });\n\n    grid.querySelectorAll(\".jst-card\").forEach(card => {\n      card.addEventListener(\"click\", () => {\n        openPopup(parseInt(card.dataset.id, 10));\n      });\n\n      card.addEventListener(\"keydown\", e => {\n        if (e.key === \"Enter\" || e.key === \" \") {\n          e.preventDefault();\n          openPopup(parseInt(card.dataset.id, 10));\n        }\n      });\n    });\n  }\n\n  function renderProducts(products) {\n    const list = Array.isArray(products) ? products : [];\n    popupProducts.setAttribute(\"data-count\", String(list.length || 1));\n\n    if (!list.length) {\n      popupProducts.innerHTML = `\n        <div class=\"jst-product-card\">\n          <div class=\"jst-product-info\">\n            <div class=\"jst-product-name\">No products available for this design.<\/div>\n          <\/div>\n        <\/div>\n      `;\n      return;\n    }\n\n    popupProducts.innerHTML = list.map(pr => `\n      <div class=\"jst-product-card\">\n        <img src=\"${pr.image}\" loading=\"lazy\" decoding=\"async\" alt=\"${pr.name}\">\n        <div class=\"jst-product-info\">\n          <div class=\"jst-product-name\">${pr.name}<\/div>\n          <a href=\"${pr.link}\" class=\"jst-product-link\" target=\"_blank\" rel=\"noopener noreferrer\">\n            Explore Material\n          <\/a>\n        <\/div>\n      <\/div>\n    `).join('');\n  }\n\n  function openPopup(id) {\n    const p = jstProjectsV3.find(x => x.id === id);\n    if (!p) return;\n\n    popupImg.src = p.image;\n    popupImg.alt = p.title;\n    popupCat.textContent = p.categoryLabel;\n    popupTitle.textContent = p.title;\n    popupDesc.textContent = p.description;\n\n    const msg = encodeURIComponent(`Hi! I'm interested in the \"${p.title}\" design. Can you help me?`);\n    whatsappBtn.href = `https:\/\/wa.me\/919829012345?text=${msg}`;\n\n    renderProducts(p.products);\n\n    root.querySelector(\".jst-popup-right\").scrollTop = 0;\n    popup.classList.add(\"open\");\n    document.body.style.overflow = \"hidden\";\n  }\n\n  function closePopup() {\n    popup.classList.remove(\"open\");\n    document.body.style.overflow = \"\";\n  }\n\n  closeBtn.addEventListener(\"click\", closePopup);\n\n  popup.addEventListener(\"click\", e => {\n    if (e.target === popup) closePopup();\n  });\n\n  window.addEventListener(\"keydown\", e => {\n    if (e.key === \"Escape\") closePopup();\n  });\n\n  buildFilters();\n  renderCards(\"all\");\n})();\n<\/script>\n\n<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\n    <div class=\"xs_social_share_widget xs_share_url after_content \t\tmain_content  wslu-style-1 wslu-share-box-shaped wslu-fill-colored wslu-none wslu-share-horizontal wslu-theme-font-no wslu-main_content\">\n\n\t\t\n        <ul>\n\t\t\t        <\/ul>\n    <\/div> \n","protected":false},"excerpt":{"rendered":"<p>Luxury Architectural Material Discovery Inspiration Gallery Explore premium design inspirations built using luxury natural stones, vitrified tiles, wall cladding and curated architectural materials. &#x2715; Featured Materials WhatsApp Us Contact Us for More Designs<\/p>\n","protected":false},"author":2,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"elementor_header_foo