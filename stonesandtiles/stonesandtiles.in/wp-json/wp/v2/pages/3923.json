font-size: 19px;\n  font-weight: 700;\n}\n\n.mi-playlist-count {\n  padding: 6px 9px;\n\n  border-radius: 7px;\n\n  background: rgba(200,132,79,.10);\n\n  color: var(--mi-muted);\n\n  font-size: 10px;\n  font-weight: 700;\n\n  letter-spacing: .8px;\n}\n\n\n\/* ==========================================================\n   PLAYLIST\n   ========================================================== *\/\n\n.mi-playlist {\n  display: flex;\n  flex-direction: column;\n\n  gap: 10px;\n\n  max-height: 480px;\n\n  overflow-y: auto;\n\n  padding-right: 5px;\n}\n\n.mi-playlist::-webkit-scrollbar {\n  width: 4px;\n}\n\n.mi-playlist::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n.mi-playlist::-webkit-scrollbar-thumb {\n  background: #D8C8B9;\n  border-radius: 10px;\n}\n\n\n\/* ==========================================================\n   VIDEO ITEM\n   ========================================================== *\/\n\n.mi-video-item {\n  width: 100%;\n\n  display: grid;\n\n  grid-template-columns: 112px 1fr;\n\n  gap: 12px;\n\n  padding: 10px;\n\n  border: 1px solid transparent;\n\n  border-radius: 12px;\n\n  background: #fff;\n\n  text-align: left;\n\n  cursor: pointer;\n\n  transition:\n    transform .25s ease,\n    box-shadow .25s ease,\n    border-color .25s ease,\n    background .25s ease;\n}\n\n.mi-video-item:hover {\n  transform: translateY(-2px);\n\n  border-color: rgba(200,132,79,.25);\n\n  box-shadow:\n    0 7px 20px rgba(43,26,18,.08);\n}\n\n.mi-video-item.active {\n  border-color: rgba(200,132,79,.40);\n\n  background: #fffaf6;\n\n  box-shadow:\n    0 5px 18px rgba(43,26,18,.07);\n}\n\n\n\/* ==========================================================\n   THUMBNAIL\n   ========================================================== *\/\n\n.mi-thumb {\n  position: relative;\n\n  width: 112px;\n\n  aspect-ratio: 16 \/ 9;\n\n  overflow: hidden;\n\n  border-radius: 8px;\n\n  background: #ddd;\n}\n\n.mi-thumb img {\n  width: 100%;\n  height: 100%;\n\n  display: block;\n\n  object-fit: cover;\n\n  transition: transform .35s ease;\n}\n\n.mi-video-item:hover .mi-thumb img {\n  transform: scale(1.06);\n}\n\n\n\/* ==========================================================\n   SMALL PLAY\n   ========================================================== *\/\n\n.mi-play-icon {\n  position: absolute;\n\n  left: 50%;\n  top: 50%;\n\n  width: 32px;\n  height: 32px;\n\n  display: flex;\n\n  align-items: center;\n  justify-content: center;\n\n  transform:\n    translate(-50%,-50%);\n\n  border-radius: 50%;\n\n  background: rgba(255,255,255,.95);\n\n  color: var(--mi-accent);\n\n  font-size: 9px;\n\n  padding-left: 2px;\n\n  box-shadow:\n    0 3px 10px rgba(0,0,0,.15);\n}\n\n\n\/* ==========================================================\n   ITEM CONTENT\n   ========================================================== *\/\n\n.mi-video-info {\n  min-width: 0;\n\n  display: flex;\n\n  flex-direction: column;\n\n  justify-content: center;\n\n  gap: 4px;\n}\n\n.mi-video-number {\n  color: var(--mi-accent);\n\n  font-size: 9px;\n\n  font-weight: 700;\n\n  letter-spacing: 1px;\n}\n\n.mi-video-title {\n  color: var(--mi-text);\n\n  font-size: 12px;\n\n  font-weight: 700;\n\n  line-height: 1.4;\n}\n\n.mi-video-meta {\n  color: #9B928A;\n\n  font-size: 9px;\n}\n\n\n\/* ==========================================================\n   CHANNEL CTA\n   ========================================================== *\/\n\n.mi-channel-cta {\n  display: flex;\n\n  align-items: center;\n  justify-content: space-between;\n\n  gap: 15px;\n\n  margin-top: 18px;\n  padding-top: 18px;\n\n  border-top: 1px solid var(--mi-border);\n}\n\n.mi-channel-text {\n  color: var(--mi-grey);\n\n  font-size: 11px;\n\n  line-height: 1.5;\n}\n\n.mi-channel-text strong {\n  display: block;\n\n  margin-bottom: 2px;\n\n  color: var(--mi-text);\n\n  font-size: 12px;\n}\n\n.mi-channel-button {\n  flex-shrink: 0;\n\n  display: inline-flex;\n\n  align-items: center;\n  justify-content: center;\n\