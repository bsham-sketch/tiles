==================================================\n   HEADER\n   ========================================================== *\/\n\n.mi-video-header {\n  position: relative;\n  padding: 46px 48px 40px;\n\n  background:\n    linear-gradient(\n      135deg,\n      #2B1A12 0%,\n      #4A2E1E 100%\n    );\n\n  color: #fff;\n  overflow: hidden;\n}\n\n.mi-video-header::before {\n  content: '';\n  position: absolute;\n\n  width: 400px;\n  height: 400px;\n\n  right: -150px;\n  top: -210px;\n\n  border-radius: 50%;\n\n  background: rgba(200,132,79,.07);\n}\n\n.mi-video-header::after {\n  content: '';\n  position: absolute;\n\n  width: 260px;\n  height: 260px;\n\n  left: -130px;\n  bottom: -180px;\n\n  border-radius: 50%;\n\n  background: rgba(200,132,79,.05);\n}\n\n\n\/* ==========================================================\n   MICRO LABEL\n   ========================================================== *\/\n\n.mi-video-micro {\n  position: relative;\n  z-index: 2;\n\n  display: flex;\n  align-items: center;\n\n  gap: 10px;\n  margin-bottom: 15px;\n}\n\n.mi-video-square {\n  width: 12px;\n  height: 12px;\n\n  display: inline-block;\n\n  background: var(--mi-accent);\n\n  box-shadow:\n    inset -3px 0 rgba(0,0,0,.12);\n}\n\n.mi-video-micro span:last-child {\n  font-size: 11px;\n  font-weight: 600;\n\n  letter-spacing: 1.7px;\n  text-transform: uppercase;\n\n  color: rgba(255,255,255,.68);\n}\n\n\n\/* ==========================================================\n   HEADER TITLE\n   ========================================================== *\/\n\n.mi-video-header h1 {\n  position: relative;\n  z-index: 2;\n\n  margin: 0 0 10px;\n\n  color: #fff;\n\n  font-size: clamp(30px,4vw,42px);\n\n  font-weight: 800;\n\n  letter-spacing: -.8px;\n  line-height: 1.1;\n}\n\n.mi-video-header h1 span {\n  color: var(--mi-accent);\n}\n\n.mi-video-subtitle {\n  position: relative;\n  z-index: 2;\n\n  max-width: 650px;\n\n  margin: 0;\n\n  color: rgba(255,255,255,.65);\n\n  font-size: 14px;\n  line-height: 1.65;\n}\n\n\n\/* ==========================================================\n   BODY\n   ========================================================== *\/\n\n.mi-video-body {\n  display: grid;\n\n  grid-template-columns:\n    minmax(0, 1.55fr)\n    minmax(330px, .85fr);\n\n  background: #fff;\n}\n\n\n\/* ==========================================================\n   FEATURED PANEL\n   ========================================================== *\/\n\n.mi-featured-panel {\n  padding: 38px 40px;\n  background: #fff;\n}\n\n.mi-section-label {\n  margin-bottom: 13px;\n\n  color: var(--mi-muted);\n\n  font-size: 11px;\n  font-weight: 700;\n\n  letter-spacing: 1.5px;\n  text-transform: uppercase;\n}\n\n\n\/* ==========================================================\n   FEATURED PLAYER\n   ========================================================== *\/\n\n.mi-featured-video {\n  position: relative;\n\n  width: 100%;\n  aspect-ratio: 16 \/ 9;\n\n  overflow: hidden;\n\n  background: #201914;\n\n  border-radius: 16px;\n\n  box-shadow:\n    0 12px 35px rgba(43,26,18,.13);\n\n  cursor: pointer;\n}\n\n.mi-featured-video img {\n  width: 100%;\n  height: 100%;\n\n  display: block;\n\n  object-fit: cover;\n\n  transition: transform .5s ease;\n}\n\n.mi-featured-video:hover img {\n  transform: scale(1.025);\n}\n\n\n\/* ==========================================================\n   FEATURED DARK OVERLAY\n   ========================================================== *\/\n\n.mi-featured-overlay {\n  position: absolute;\n  inset: 0;\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  background:\n    linear-gradient(\n      180deg,\n      rgba(0,0,0,.05),\n      rgba(0,0,0,.28)\n    );\n}\n\n\n\/* ==========================================================\n   LARGE PLAY BUTTON\n   ========================================================== *\/\n\n.mi-main-play {\n  width: 76px;\n  height: 76px;\n\n  display: flex;\n  align-items: center;\n  justify-conten