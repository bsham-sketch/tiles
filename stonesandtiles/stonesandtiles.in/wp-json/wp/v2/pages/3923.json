 =\n    app.querySelectorAll('.mi-video-item');\n\n\n  \/*\n   * Load YouTube player only after\n   * visitor clicks the featured video.\n   *\/\n\n  featured.addEventListener('click', function() {\n\n    const videoID =\n      featured.getAttribute('data-video');\n\n\n    if (!videoID) return;\n\n\n    const iframe =\n      document.createElement('iframe');\n\n\n    iframe.src =\n      'https:\/\/www.youtube.com\/embed\/' +\n      videoID +\n      '?autoplay=1&rel=0&modestbranding=1';\n\n\n    iframe.title =\n      'Maheshwari Impex Video';\n\n\n    iframe.setAttribute(\n      'allow',\n      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'\n    );\n\n\n    iframe.setAttribute(\n      'allowfullscreen',\n      ''\n    );\n\n\n    iframe.style.width = '100%';\n\n    iframe.style.height = '100%';\n\n    iframe.style.border = '0';\n\n    iframe.style.display = 'block';\n\n\n    featured.innerHTML = '';\n\n    featured.appendChild(iframe);\n\n  });\n\n\n  \/*\n   * Playlist interaction\n   *\/\n\n  videos.forEach(function(video) {\n\n    video.addEventListener('click', function() {\n\n\n      const videoID =\n        this.getAttribute('data-video');\n\n\n      const videoTitle =\n        this.getAttribute('data-title');\n\n\n      const videoDescription =\n        this.getAttribute('data-description');\n\n\n      if (!videoID) return;\n\n\n      \/*\n       * Update featured data\n       *\/\n\n      featured.setAttribute(\n        'data-video',\n        videoID\n      );\n\n\n      \/*\n       * Restore thumbnail player\n       *\/\n\n      featured.innerHTML = '';\n\n\n      const image =\n        document.createElement('img');\n\n\n      image.src =\n        'https:\/\/img.youtube.com\/vi\/' +\n        videoID +\n        '\/maxresdefault.jpg';\n\n\n      image.alt =\n        videoTitle;\n\n\n      featured.appendChild(image);\n\n\n      const overlay =\n        document.createElement('div');\n\n\n      overlay.className =\n        'mi-featured-overlay';\n\n\n      overlay.innerHTML =\n        '<div class=\"mi-main-play\">\u25b6<\/div>';\n\n\n      featured.appendChild(overlay);\n\n\n      const badge =\n        document.createElement('div');\n\n\n      badge.className =\n        'mi-featured-badge';\n\n\n      badge.textContent =\n        'Play Video';\n\n\n      featured.appendChild(badge);\n\n\n      \/*\n       * Update information\n       *\/\n\n      featuredTitle.textContent =\n        videoTitle || '';\n\n\n      featuredDescription.textContent =\n        videoDescription || '';\n\n\n      \/*\n       * Active item\n       *\/\n\n      videos.forEach(function(item) {\n\n        item.classList.remove('active');\n\n      });\n\n\n      this.classList.add('active');\n\n\n      \/*\n       * Mobile scroll\n       *\/\n\n      if (window.innerWidth <= 900) {\n\n        featured.scrollIntoView({\n          behavior: 'smooth',\n          block: 'start'\n        });\n\n      }\n\n    });\n\n  });\n\n\n})();\n\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\n    <div class=\"xs_social_share_widget xs_share_url after_content \t\tmain_content  wslu-style-1 wslu-share-box-shaped wslu-fill-colored wslu-none wslu-share-horizontal wslu-theme-font-no wslu-main_content\">\n\n\t\t\n        <ul>\n\t\t\t        <\/ul>\n    <\/div> \n","protected":false},"excerpt":{"rendered":"<p>Visual Stories Tiles &amp; Granite in Motion Explore our latest collections, surface finishes, design ideas, installations and completed projects through our video stories. Featured Video \u25b6 Play Video Premium Tiles &amp; Granite Collection Explore our latest tile and granite collection, surface finishes, designs and applications. Latest Videos 07 VIDEOS \u25b6 01 Premium Tiles &amp; Granite [&hellip;]<\/p>\n","protected":false},"author":2,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"elementor_header_footer","me